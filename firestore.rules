rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return signedIn() ? request.auth.token.email : null; }
    function isOwner() { return signedIn() && email() == 'madriagakenneth22@gmail.com'; }
    function member(ws) { return get(/databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid)).data; }
    function isMember(ws) { return signedIn() && exists(/databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid)) && member(ws).active == true; }
    function isAdmin(ws) { return isMember(ws) && (member(ws).role == 'ADMIN' || member(ws).role == 'SUPER_ADMIN'); }
    function isSuperAdmin(ws) { return isMember(ws) && member(ws).role == 'SUPER_ADMIN'; }

    match /workspaces/{ws}/members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin(ws));
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.active == true && (
        // The configured owner may bootstrap only the intended payroll workspace.
        (ws == 'ph-payroll-main' && isOwner() && request.resource.data.role == 'SUPER_ADMIN' && request.resource.data.email == email()) ||
        (exists(/databases/$(database)/documents/workspaces/$(ws)/invites/$(email())) &&
         get(/databases/$(database)/documents/workspaces/$(ws)/invites/$(email())).data.active == true &&
         request.resource.data.role == get(/databases/$(database)/documents/workspaces/$(ws)/invites/$(email())).data.role &&
         request.resource.data.employeeId == get(/databases/$(database)/documents/workspaces/$(ws)/invites/$(email())).data.employeeId &&
         request.resource.data.email == email())
      );
      // The configured owner can always repair their own member document back
      // to the canonical SUPER_ADMIN identity for this one workspace. This is a
      // recovery path for stale records created by older builds; it cannot be used
      // to promote another UID or another email.
      allow update: if (
          ws == 'ph-payroll-main'
          && isOwner()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == email()
          && request.resource.data.role == 'SUPER_ADMIN'
          && request.resource.data.active == true
          && request.resource.data.employeeId == null
        )
        || isSuperAdmin(ws)
        || (
          isAdmin(ws)
          && resource.data.role == 'EMPLOYEE'
          && request.resource.data.role == 'EMPLOYEE'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'active', 'deactivatedAt', 'deactivatedBy', 'deactivationReason'
          ])
          && request.resource.data.active == false
          && request.resource.data.deactivatedBy == request.auth.uid
        );
      allow delete: if isSuperAdmin(ws);
    }

    match /workspaces/{ws}/invites/{inviteEmail} {
      allow read: if isAdmin(ws) || (signedIn() && email() == inviteEmail);

      // Only Super Admin can create administrator invitations. Normal Admin / HR
      // can create employee invitations only.
      allow create: if isSuperAdmin(ws) || (
        isAdmin(ws)
        && request.resource.data.role == 'EMPLOYEE'
        && request.resource.data.email == inviteEmail
        && request.resource.data.active == true
      );

      // Admin / HR may maintain employee invitations, but administrator invites
      // remain Super-Admin-only. An invitee may only mark their own invite claimed.
      allow update: if isSuperAdmin(ws) || (
        isAdmin(ws)
        && resource.data.role == 'EMPLOYEE'
        && request.resource.data.role == 'EMPLOYEE'
      ) || (
        signedIn()
        && email() == inviteEmail
        && resource.data.active == true
        && request.resource.data.active == false
        && request.resource.data.role == resource.data.role
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','claimedBy','claimedAt'])
        && request.resource.data.claimedBy == request.auth.uid
      );
      allow delete: if isSuperAdmin(ws) || (isAdmin(ws) && resource.data.role == 'EMPLOYEE');
    }

    match /workspaces/{ws}/state/{docId} { allow read, write: if isAdmin(ws); }
    match /workspaces/{ws}/employees/{docId} { allow read, write: if isAdmin(ws); }
    match /workspaces/{ws}/attendance/{docId} { allow read, write: if isAdmin(ws); }

    match /workspaces/{ws}/leaves/{docId} {
      allow read: if isAdmin(ws) || (
        isMember(ws)
        && member(ws).role == 'EMPLOYEE'
        && resource.data.record.employeeId == member(ws).employeeId
      );

      // Employees can submit only a new pending request for their own linked
      // employee ID. Approval/rejection/cancellation remains an admin operation.
      allow create: if isAdmin(ws) || (
        isMember(ws)
        && member(ws).role == 'EMPLOYEE'
        && request.resource.data.keys().hasOnly(['record','updatedAt','updatedBy'])
        && request.resource.data.record.keys().hasOnly([
          'id','employeeId','type','from','to','paid','note','status',
          'requestedAt','requestedByUid','requestedByEmail'
        ])
        && request.resource.data.record.id == docId
        && request.resource.data.record.employeeId == member(ws).employeeId
        && request.resource.data.record.status == 'PENDING'
        && request.resource.data.record.type in ['Vacation Leave','Sick Leave','Emergency Leave','Bereavement Leave','Unpaid Leave','Other']
        && request.resource.data.record.from <= request.resource.data.record.to
        && request.resource.data.record.requestedByUid == request.auth.uid
        && request.resource.data.record.requestedByEmail == email()
        && request.resource.data.updatedBy == request.auth.uid
      );
      allow update, delete: if isAdmin(ws);
    }

    match /workspaces/{ws}/holidays/{docId} { allow read, write: if isAdmin(ws); }
    match /workspaces/{ws}/loans/{docId} { allow read, write: if isAdmin(ws); }
    match /workspaces/{ws}/payrolls/{docId} { allow read, write: if isAdmin(ws); }
    match /workspaces/{ws}/audit/{docId} { allow read, write: if isAdmin(ws); }
    match /workspaces/{ws}/rules/{docId} { allow read, write: if isAdmin(ws); }
    match /workspaces/{ws}/closures/{docId} { allow read, write: if isAdmin(ws); }

    match /workspaces/{ws}/employeeAccess/{employeeId} {
      // The authenticated member record is the authorization source. Do not
      // additionally depend on duplicated googleEmail/active fields inside the
      // employeeAccess mirror: older mirrors may not contain those fields and
      // could lock a correctly invited employee out. HR still controls access by
      // activating/deactivating the member and its linked employeeId.
      allow read: if isAdmin(ws) || (
        isMember(ws)
        && member(ws).role == 'EMPLOYEE'
        && member(ws).employeeId == employeeId
      );
      allow write: if isAdmin(ws);
    }
  }
}
